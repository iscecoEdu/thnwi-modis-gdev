pe":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["0","=","1"]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["CountDown","Text","=","\"1. \" + \" .. \" + countDownTotalTime + \" .. \" + countdownMinutes + \":\" + countDownSeconds + \"--\" + ToString(TimerElapsedTime(\"countDownTimer\"))"]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["countdownMinutes","<","10"]}],"actions":[{"type":{"value":"SetStringVariable"},"parameters":["countDownTime[0]","=","\"Countdown: \" + \"0\" + countdownMinutes + \":\""]},{"type":{"value":"SetStringVariable"},"parameters":["countDownTxt","=","countDownTime[0] + countDownTime[1]"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["CountDown","Text","=","countDownTxt"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["countDownSeconds","<","10"]}],"actions":[{"type":{"value":"SetStringVariable"},"parameters":["countDownTime[1]","=","\"0\" + countDownSeconds"]},{"type":{"value":"SetStringVariable"},"parameters":["countDownTxt","=","countDownTime[0] + countDownTime[1]"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["CountDown","Text","=","countDownTxt"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::CompareNumbers"},"parameters":["0","=","1"]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["CountDown","Text","=","\"1. \" + \" .. \" + countDownTotalTime + \" .. \" + countdownMinutes + \":\" + countDownSeconds + \"--\" + ToString(TimerElapsedTime(\"countDownTimer\"))"]}]}]}],"tests":[{"description":"","lastRunAt":1787683084865.0,"lastRunDurationMs":1352.0,"lastRunFramesExecuted":60,"lastRunStatus":"passed","name":"first test","type":"gameplay","source":["// This script plays the game and checks it behaves as expected.","// It runs inside the game: use `harness` to play frames, simulate","// the player inputs and inspect the objects of the scene.","","// The game starts on its first scene. You can jump to any scene:","// await harness.goToScene('MyLevel');","","// Play one second of the game (60 frames):","await harness.stepFrames(60);","","// Simulate the player pressing a key (also see setMousePosition,","// setMouseButtonPressed, touchStart...):","// harness.setKeyPressed('Right', true);","// await harness.stepFrames(30);","// harness.setKeyPressed('Right', false);","","// Inspect objects and check the game state - a failed assert fails the test:","// const players = harness.getObjects('Player');","// harness.assert(players.length === 1, 'The player is in the scene');","","console.log('Scene at the end of the test:', harness.getSceneName());",""]},{"description":"Verifiziert Kernmechaniken: Bewegung, Schiessen, alle Quizfragen beantworten mit Levelwechsel.","lastRunAt":1787720394306.0,"lastRunDurationMs":5606.0,"lastRunFramesExecuted":231,"lastRunStatus":"passed","name":"lever1-test","type":"gameplay","source":["// Test: verifiziert die Kernmechaniken des Spiels.","// 1) Bewegung, 2) Schiessen, 3) alle Quizfragen beantworten + Levelwechsel.","const PLAYER = 'player2';","","async function clickObject(name) {","  const objs = harness.getObjects(name);","  if (!objs.length) return false;","  const o = objs[0];","  harness.setMousePosition(o.centerX, o.centerY);","  await harness.stepFrames(1);","  harness.setMouseButtonPressed(true, 'left');","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false, 'left');","  await harness.stepFrames(2);","  return true;","}","","// --- Teil 1: Bewegung ---","await harness.goToScene('level1');","await harness.stepFrames(60);","const start = harness.getObjects(PLAYER)[0];","harness.assert(!!start, 'Player exists in level1');","const startX = start.x;","harness.setKeyPressed('Right', true);","await harness.stepFrames(60);","harness.setKeyPressed('Right', false);","const after = harness.getObjects(PLAYER)[0];","harness.assert(after.x > startX + 50, 'Player moves right (movement works)');","","// --- Teil 2: Schiessen ---","harness.setKeyPressed('s', true);","await harness.stepFrames(12);","harness.setKeyPressed('s', false);","await harness.stepFrames(2);","harness.assert(harness.getObjects('throwableKeyboard').length > 0, 'Shooting spawns a projectile');","","// --- Teil 3: Alle Quizfragen beantworten + Levelwechsel ---","harness.setGlobalVariable('lehrjahr', 1);","await harness.goToScene('Quiz');","await harness.stepFrames(15);","for (let q = 0; q < 4; q++) {","  let clicked = false;","  for (const name of ['Button1', 'Button2', 'Button3', 'Button4']) {","    const objs = harness.getObjects(name);","    if (!objs.length) continue;","    const v = harness.getObjectVariable(objs[0].id, 'isCorrect');","    if (v && v.value === true) { await clickObject(name); clicked = true; break; }","  }","  harness.assert(clicked, 'Answered question ' + (q + 1));","  let g = 0;","  while (harness.getObjects('NextQuestionButton').length === 0 && g < 120) { await harness.stepFrames(1); g++; }","  await clickObject('NextQuestionButton');","  await harness.stepFrames(5);","}","let g = 0;","while (harness.getObjects('NextLevelButton').length === 0 && g < 120) { await harness.stepFrames(1); g++; }","await clickObject('NextLevelButton');","await harness.stepFrames(15);","harness.assert(harness.getSceneName() === 'level2', 'Quiz advances to level2, got ' + harness.getSceneName());",""]}],"eventsFunctionsExtensions":[{"author":"westboy, daliyoucefmedakram@gmail.com, @bouh","category":"User interface","dimension":"","extensionNamespace":"","fullName":"Auto typing animation for text (\"typewriter\" effect)","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;b