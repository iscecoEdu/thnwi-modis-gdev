{"firstLayout":"","gdVersion":{"build":280,"major":5,"minor":6,"revision":0},"properties":{"adaptGameResolutionAtRuntime":true,"antialiasingMode":"MSAA","antialisingEnabledOnMobile":true,"folderProject":true,"orientation":"default","packageName":"ch.admin.mission_informatik_lehre","pixelsRounding":true,"projectUuid":"278e4623-0afa-4be6-9ae7-69acacad6fe8","scaleMode":"linear","sizeOnStartupMode":"adaptWidth","templateSlug":"","useDeprecatedZeroAsDefaultStringVariable":true,"version":"1.0.0","name":"MissionInformatikLehre","description":"🎮 MIL GDevelop Gamification Mission – Informatik Lehre\nEin innovatives Gamification-Projekt zur Unterstützung der Informatik-Lehre, entwickelt mit GDevelop.\nInformation Service Center (ISCeco)- Entwickelt von den Lernenden vom ISCeco\n\n🚀 Projektüberblick\nMIL (Mission Informatik Lehre) ist ein interaktives Lernspiel, das speziell für Informatiker/in EFZ Applikationsentwicklung entwickelt wurde.\nZiel ist es, durch spielerische Missionen, interaktive Rückmeldungen und motivierende Mechaniken den Lernerfolg von Lernenden messbar zu steigern.\n\n🔗 Modulbaukasten-URL: https://www.modulbaukasten.ch/?d=13d8d40b-6d82-eb11-a812-0022486f6f83 🔗 GitHub-URL: iscecoEdu/thnwi-modis-gdev\n\n🧠 Didaktisches Ziel\n🎯 Förderung von Problemlösekompetenzen in Informatik\n🎓 Integration didaktisch fundierter Gamification-Prinzipien\n🧩 Unterstützung individueller Lernpfade durch verschiedene Szenarien\n🔧 Technischer Stack\nKomponente\tBeschreibung\n🎮 GDevelop\tOpen-Source No-Code-Game-Engine\n🖼️ Assets\tCommunity und überwiegend Eigenentwickelte Icons, Animationen & UI\n💾 Speicherung\tLokale Speicherung von Spielfortschritt\n🌐 Plattform\tHTML5, Desktop-Export (Windows/Linux/Mac)\n🎲 Features\n🧭 Lern-Missionen mit Feedback-Mechanismen\n🎯 Levelstrukturierung nach informatischen Konzepten\n🧠 Reflexionsfragen & Wissensabfragen eingebettet\n📁 Projektstruktur\nthnwi-modis-gdev/\n│\n├──MIL\n│ ├── assets/ # Bilder, Icons, Sounds\n│ ├── scenes/ # GDevelop-Szenendateien (*.json)\n│ └── logic/ # Globale Variablen, Funktionen\n├── exports/ # HTML5/Native-Export\n└── README.md # Dieses Dokument\n\nEntwickler-Team\nLoris G.: Lernender Informatiker Applikationsentwickler mit Abgeschlossener EFZ\nJessika N.: Lernende Informatikerin Applikationsentwicklerin 4. Lehrjahr\nSelina K.: Lernende Informatikerin Applikationsentwicklerin 2. Lehrjahr\nAaron F.: Lernender Informatiker Applikationsentwickler 2. Lehrjahr\n\nPowered by ISCeco\n\n\n\n","author":"Mission Informatik Lehre powered by ISCeco","windowWidth":720,"windowHeight":1280,"latestCompilationDirectory":"J:\\00-vm\\projects\\fa-int\\Ausbildung\\informatik\\thinkhacknwinit\\thnwi-modis-gdev\\mil\\html5exports\\20250728","maxFPS":0,"minFPS":20,"verticalSync":false,"platformSpecificAssets":{"android-icon-144":"","android-icon-192":"","android-icon-36":"","android-icon-48":"","android-icon-72":"","android-icon-96":"","android-windowSplashScreenAnimatedIcon":"","desktop-icon-512":"","ios-icon-100":"","ios-icon-1024":"","ios-icon-114":"","ios-icon-120":"","ios-icon-144":"","ios-icon-152":"","ios-icon-167":"","ios-icon-180":"","ios-icon-20":"","ios-icon-29":"","ios-icon-40":"","ios-icon-50":"","ios-icon-57":"","ios-icon-58":"","ios-icon-60":"","ios-icon-72":"","ios-icon-76":"","ios-icon-80":"","ios-icon-87":""},"loadingScreen":{"backgroundColor":0,"backgroundFadeInDuration":0.2,"backgroundImageResourceName":"assets\\LoadingScreen.png","gdevelopLogoStyle":"light","logoAndProgressFadeInDuration":0.5,"logoAndProgressLogoFadeInDelay":2.0,"minDuration":1.5,"progressBarColor":16777215,"progressBarHeight":20.0,"progressBarMaxWidth":200.0,"progressBarMinWidth":40.0,"progressBarWidthPercent":30.0,"showGDevelopSplash":true,"showProgressBar":true},"watermark":{"placement":"bottom-left","showWatermark":true},"authorIds":["ftwV8qCmEofFHp6diENHS7xnneJ3"],"authorUsernames":[],"categories":["educational","platformer"],"playableDevices":["keyboard","gamepad","mobile"],"extensionProperties":[],"platforms":